# Local paths (never commit .env)
MAZU_INDICATOR_DIR=data/processed/mazu_2025
GRAPHCAST_CACHE_DIR=data/raw/graphcast_2020
IMERG_DIR=data/raw/imerg
GHCN_DIR=data/raw/ghcn

# Optional Neo4j connection for member C
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional controlled report Agent. Keep the real key only in local .env or the shell.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.stellarmesh.net/v1
SAUDI_WARNING_AGENT_MODEL=gpt-5.6-luna
SAUDI_WARNING_AGENT_ESCALATION_MODEL=gpt-5.6-terra
# Use responses for official-compatible endpoints; use chat_completions if the relay lacks /responses.
SAUDI_WARNING_AGENT_API_MODE=responses
