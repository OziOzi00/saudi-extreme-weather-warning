{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled_orchestrator_run_manifest_v1.schema.json",
  "title": "Controlled orchestrator completed run manifest v1",
  "type": "object",
  "required": ["schema_version", "status", "truth_accessed", "request", "completed_stages", "artifacts", "selection_lock_sha256", "completed_at"],
  "properties": {
    "schema_version": {"const": "controlled_orchestrator_run_manifest_v1"},
    "status": {"const": "passed"},
    "truth_accessed": {"const": false},
    "request": {"type": "object"},
    "completed_stages": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "selection_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "completed_at": {"type": "string"}
  }
}
