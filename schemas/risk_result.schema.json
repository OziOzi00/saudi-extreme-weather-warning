{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk_result.schema.json",
  "title": "Saudi extreme weather risk result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "source_file", "initial_time", "lead_time_hours", "valid_start_time", "valid_end_time", "region_id", "region_name", "hazard", "risk_level", "risk_score", "confidence", "rule_id", "indicator_summary", "supporting_evidence", "contradicting_evidence", "missing_evidence", "verification", "created_at"],
  "properties": {
    "schema_version": {"const": "risk_result_v1"},
    "case_id": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "pattern": "^handoff/mazu_like/mazu_like_.+_lead(024|048|072)\\.nc$"},
    "initial_time": {"type": "string", "format": "date-time"},
    "lead_time_hours": {"enum": [24, 48, 72]},
    "valid_start_time": {"type": "string", "format": "date-time"},
    "valid_end_time": {"type": "string", "format": "date-time"},
    "region_id": {"type": "string", "minLength": 1},
    "region_name": {"type": "string", "minLength": 1},
    "hazard": {"enum": ["heavy_rain", "heatwave"]},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "risk_score": {"type": "number"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_status": {"enum": ["draft", "frozen", "example"]},
    "indicator_summary": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}},
    "supporting_evidence": {"type": "array", "items": {"type": "object"}},
    "contradicting_evidence": {"type": "array", "items": {"type": "object"}},
    "missing_evidence": {"type": "array", "items": {"type": "object"}},
    "verification": {"type": ["object", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "description_zh": {"type": "string"}
  }
}
