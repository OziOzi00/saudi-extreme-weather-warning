{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_dual_prediction_report_v1.schema.json",
  "title": "Immutable system forecast plus separately scored LLM advisory report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_mode",
    "truth_accessed",
    "case_id",
    "region_id",
    "hazard",
    "dataset_split",
    "focus_lead_time_hours",
    "selected_joint_rule",
    "development_gate_passed",
    "operating_status",
    "formal_warning_allowed",
    "system_focus_risk_level",
    "llm_focus_advisory_risk_level",
    "llm_focus_confidence",
    "focus_agreement",
    "system_analysis_zh",
    "llm_advisory_summary_zh",
    "comparison_analysis_zh",
    "timeline_analysis",
    "uncertainty_analysis_zh",
    "limitations_zh",
    "recommended_actions_zh",
    "provenance_summary_zh",
    "generation_mode"
  ],
  "properties": {
    "schema_version": {"const": "agent_dual_prediction_report_v1"},
    "report_mode": {"const": "system_plus_llm_advisory"},
    "truth_accessed": {"const": false},
    "case_id": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "pattern": "^SA-[0-9]{2}$"},
    "hazard": {"enum": ["heavy_rain", "heatwave"]},
    "dataset_split": {"enum": ["development", "independent_test"]},
    "focus_lead_time_hours": {"const": 48},
    "selected_joint_rule": {"type": "string", "minLength": 1},
    "development_gate_passed": {"type": "boolean"},
    "operating_status": {"enum": ["research_candidate", "research_only_blocked"]},
    "formal_warning_allowed": {"const": false},
    "system_focus_risk_level": {"$ref": "#/$defs/riskLevel"},
    "llm_focus_advisory_risk_level": {"$ref": "#/$defs/riskLevel"},
    "llm_focus_confidence": {"$ref": "#/$defs/confidence"},
    "focus_agreement": {"type": "boolean"},
    "system_analysis_zh": {"type": "string", "minLength": 1},
    "llm_advisory_summary_zh": {"type": "string", "minLength": 1},
    "comparison_analysis_zh": {"type": "string", "minLength": 1},
    "timeline_analysis": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/timelineItem"}
    },
    "uncertainty_analysis_zh": {"type": "string", "minLength": 1},
    "limitations_zh": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_actions_zh": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance_summary_zh": {"type": "string", "minLength": 1},
    "generation_mode": {"enum": ["openai_luna", "openai_terra"]}
  },
  "$defs": {
    "riskLevel": {"enum": ["low", "medium", "high"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead_time_hours",
        "system_base_risk_level",
        "system_knowledge_triggered",
        "system_joint_final_risk_level",
        "llm_advisory_risk_level",
        "llm_advisory_confidence",
        "agreement_with_system",
        "advisory_analysis_zh",
        "key_signals_zh"
      ],
      "properties": {
        "lead_time_hours": {"enum": [24, 48, 72]},
        "system_base_risk_level": {"$ref": "#/$defs/riskLevel"},
        "system_knowledge_triggered": {"type": "boolean"},
        "system_joint_final_risk_level": {"$ref": "#/$defs/riskLevel"},
        "llm_advisory_risk_level": {"$ref": "#/$defs/riskLevel"},
        "llm_advisory_confidence": {"$ref": "#/$defs/confidence"},
        "agreement_with_system": {"type": "boolean"},
        "advisory_analysis_zh": {"type": "string", "minLength": 1},
        "key_signals_zh": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
