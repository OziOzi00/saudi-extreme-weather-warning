{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_joint_forecast_report.schema.json",
  "title": "Truth-free joint weather-rule and knowledge-correction report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_mode", "truth_accessed", "dataset_split",
    "evaluation_character", "hazard", "case_id", "region_id", "lead_time_hours",
    "selected_joint_rule", "base_method", "knowledge_mode", "base_risk_level",
    "knowledge_triggered", "joint_final_risk_level", "decision_change",
    "development_gate_passed", "operating_status", "formal_warning_allowed",
    "forecast_features", "conclusion_zh", "knowledge_reasoning_zh",
    "limitations_zh", "recommended_actions_zh", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "agent_joint_forecast_report_v4"},
    "report_mode": {"const": "joint_forecast"},
    "truth_accessed": {"const": false},
    "dataset_split": {"enum": ["development", "independent_test"]},
    "evaluation_character": {"enum": ["retrospective_development", "nonblind_existing_split_replay"]},
    "hazard": {"enum": ["heavy_rain", "heatwave"]},
    "case_id": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "minLength": 1},
    "lead_time_hours": {"type": "integer", "minimum": 0},
    "selected_joint_rule": {"type": "string", "minLength": 1},
    "base_method": {"type": "string", "minLength": 1},
    "knowledge_mode": {"type": "string", "minLength": 1},
    "base_risk_level": {"enum": ["low", "medium", "high"]},
    "knowledge_triggered": {"type": "boolean"},
    "joint_final_risk_level": {"enum": ["low", "medium", "high"]},
    "decision_change": {"enum": ["unchanged", "upgraded"]},
    "development_gate_passed": {"type": "boolean"},
    "operating_status": {"enum": ["research_candidate", "research_only_blocked"]},
    "formal_warning_allowed": {"const": false},
    "forecast_features": {"type": "object"},
    "conclusion_zh": {"type": "string", "minLength": 1},
    "knowledge_reasoning_zh": {"type": "string", "minLength": 1},
    "limitations_zh": {"type": "array", "items": {"type": "string"}},
    "recommended_actions_zh": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_lock_path", "prediction_lock_sha256", "selection_lock_path", "selection_lock_sha256"],
      "properties": {
        "prediction_lock_path": {"type": "string"},
        "prediction_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_lock_path": {"type": "string"},
        "selection_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
