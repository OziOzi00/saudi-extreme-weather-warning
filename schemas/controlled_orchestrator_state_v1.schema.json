{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled_orchestrator_state_v1.schema.json",
  "title": "Controlled orchestrator resumable state v1",
  "type": "object",
  "required": ["schema_version", "truth_accessed", "request", "status", "stages", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "controlled_orchestrator_state_v1"},
    "truth_accessed": {"const": false},
    "status": {"enum": ["pending", "running", "failed", "complete"]},
    "request": {
      "type": "object",
      "required": ["run_id", "case_id", "initial_time", "hazard", "region_ids", "focus_lead_time_hours"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "initial_time": {"type": "string", "pattern": "Z$"},
        "hazard": {"enum": ["heavy_rain", "heatwave"]},
        "region_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "focus_lead_time_hours": {"enum": [24, 48, 72]}
      }
    },
    "stages": {
      "type": "object",
      "required": [
        "preflight",
        "forecast_materialization",
        "contract_validation",
        "region_summary",
        "joint_inference_and_lock",
        "neo4j_publish_and_query",
        "live_agent_reports",
        "finalize_manifest"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {"status": {"enum": ["pending", "running", "failed", "completed"]}}
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
